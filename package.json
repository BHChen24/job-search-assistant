{
	"name": "job-search-assistant",
	"version": "1.0.0",
	"description": "CLI that analyzes a job market from posting PDFs, finds resume gaps, and assesses new postings for fit and legitimacy, using LLM agents with structured outputs.",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "tsx src/main.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src tests package.json tsconfig.json biome.json"
	},
	"keywords": [
		"llm",
		"agents",
		"openrouter",
		"structured-output",
		"job-search",
		"resume",
		"cli",
		"typescript"
	],
	"author": "BHChen24",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BHChen24/job-search-assistant.git"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@11.20.0",
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.83.0",
		"@earendil-works/pi-ai": "0.83.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@tavily/core": "^0.7.6",
		"commander": "^15.0.0",
		"loglevel": "^1.9.2",
		"openai": "^7.4.0",
		"pdf-parse": "^2.4.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.1.2",
		"tsx": "^4.23.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
